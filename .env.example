# Copy this file to .env and fill in your own Supabase Session Pooler connection string.
# Keep the real .env file private; do not commit it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Used by the API to verify Supabase Auth access tokens. This publishable key
# is not a database password or a secret/service-role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY

# The address of the local frontend allowed to call this API.
FRONTEND_URL=http://localhost:5173

# Optional: defaults to 5000 if omitted.
PORT=5000

# Optional: defaults to supabase-root.crt beside server.js if omitted.
# SSL_ROOT_CERT=supabase-root.crt
